{
  "manifest_version": 2,
  "name": "Send to nvALT",
  "version": "1.0.1",
  "description": "Send the page, the selection, or chosen blocks to nvALT as Markdown.",
  "browser_action": {
    "default_title": "Send to nvALT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nvALT_16.png",
      "32": "icons/nvALT_32.png"
    }
  },
  "icons": {
    "16": "icons/nvALT_16.png",
    "32": "icons/nvALT_32.png",
    "128": "icons/nvALT_128.png"
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-nvalt@elasticthreads.net",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
